# ─── Application ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ─── Neo4j ────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphbos2026

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# ─── Google Gemini ────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_TOKENS=2048

# ─── Embedding ────────────────────────────────────────────────
# Set to "ollama" for local, "stub" for POC placeholder
EMBEDDING_PROVIDER=stub
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── Merge Curator ────────────────────────────────────────────
# Cron schedule for temp→main merge job (default: every 30 min)
MERGE_CRON_SCHEDULE=*/30 * * * *
MERGE_MIN_CONFIDENCE=0.75
MERGE_MIN_ACCESS_COUNT=3
